<Window x:Class="ArcadeLeverKeyConfig.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="表示・入力設定"
        Width="660"
        Height="820"
        MinWidth="560"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        Foreground="#1D2939"
        FontFamily="Yu Gothic UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#D0D5DD" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF6FF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667085" />

        <Style x:Key="BindingButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsListening}" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UtilityButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="15,6" />
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource UtilityButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="MinWidth" Value="108" />
        </Style>

        <Style x:Key="CharacterComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CharacterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="138" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CharacterComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="SelectorBorder"
                                                Background="{StaticResource PanelBrush}"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Grid Margin="10,0,9,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" />
                                                <Path Grid.Column="1"
                                                      Width="8"
                                                      Height="4"
                                                      Margin="10,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="{StaticResource MutedBrush}"
                                                      StrokeLineJoin="Round"
                                                      StrokeThickness="1.5" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SelectorBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="SelectorBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <ScrollViewer MaxHeight="180" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#F2F4F7" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9,9,0,0">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PanelBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="KeyboardBindingRowTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{Binding Label}" />
                <Button Grid.Column="1"
                        Content="{Binding DisplayValue}"
                        Click="KeyBindingButton_Click"
                        Style="{StaticResource BindingButtonStyle}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GamepadBindingRowTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{Binding Label}" />
                <Button Grid.Column="1"
                        Content="{Binding DisplayValue}"
                        Click="GamepadBindingButton_Click"
                        Style="{StaticResource BindingButtonStyle}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="25" FontWeight="Bold" Text="表示・入力設定" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,9,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           Text="キャラクター" />
                <ComboBox x:Name="CharacterSelector"
                          ItemsSource="{Binding Characters}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id"
                          DropDownOpened="CharacterSelector_DropDownOpened"
                          SelectionChanged="CharacterSelector_SelectionChanged"
                          Style="{StaticResource CharacterComboBoxStyle}" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Margin="0,16,0,16">
            <TabItem Header="キーボード">
                <Border Padding="0,12,0,0" Background="{StaticResource PanelBrush}" CornerRadius="0,10,10,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,4,14,14">
                            <Border Padding="16,12" Background="#F8FAFC" CornerRadius="9">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Text="レバー" />
                                    <ItemsControl Margin="0,5,0,0"
                                                  ItemsSource="{Binding LeverBindings}"
                                                  ItemTemplate="{StaticResource KeyboardBindingRowTemplate}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,10,0,0" Padding="16,12" Background="#F8FAFC" CornerRadius="9">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Text="上段ボタン" />
                                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="画面の左から 1 → 4" />
                                    </Grid>
                                    <ItemsControl Margin="0,5,0,0"
                                                  ItemsSource="{Binding UpperButtonBindings}"
                                                  ItemTemplate="{StaticResource KeyboardBindingRowTemplate}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,10,0,0" Padding="16,12" Background="#F8FAFC" CornerRadius="9">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Text="下段ボタン" />
                                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="画面の左から 1 → 4" />
                                    </Grid>
                                    <ItemsControl Margin="0,5,0,0"
                                                  ItemsSource="{Binding LowerButtonBindings}"
                                                  ItemTemplate="{StaticResource KeyboardBindingRowTemplate}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="アケコン / コントローラー">
                <Border Padding="0,12,0,0" Background="{StaticResource PanelBrush}" CornerRadius="0,10,10,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,4,14,14">
                            <Border x:Name="GamepadConnectionBadge"
                                    Padding="12,8"
                                    Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="8">
                                <DockPanel>
                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{StaticResource AccentBrush}" />
                                    <TextBlock x:Name="GamepadConnectionText"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="アケコンを接続してください" />
                                </DockPanel>
                            </Border>
                            <Border Margin="0,10,0,0" Padding="16,12" Background="#F8FAFC" CornerRadius="9">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Text="レバー" />
                                    <ItemsControl Margin="0,5,0,0"
                                                  ItemsSource="{Binding GamepadLeverBindings}"
                                                  ItemTemplate="{StaticResource GamepadBindingRowTemplate}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,10,0,0" Padding="16,12" Background="#F8FAFC" CornerRadius="9">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Text="上段ボタン" />
                                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="画面の左から 1 → 4" />
                                    </Grid>
                                    <ItemsControl Margin="0,5,0,0"
                                                  ItemsSource="{Binding GamepadUpperButtonBindings}"
                                                  ItemTemplate="{StaticResource GamepadBindingRowTemplate}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,10,0,0" Padding="16,12" Background="#F8FAFC" CornerRadius="9">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Text="下段ボタン" />
                                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="画面の左から 1 → 4" />
                                    </Grid>
                                    <ItemsControl Margin="0,5,0,0"
                                                  ItemsSource="{Binding GamepadLowerButtonBindings}"
                                                  ItemTemplate="{StaticResource GamepadBindingRowTemplate}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

        </TabControl>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       Text="設定を読み込みました。" />

            <Grid Grid.Row="1" Margin="0,13,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="再読み込み" Click="ReloadButton_Click" Style="{StaticResource UtilityButtonStyle}" />
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="初期設定に戻す"
                        Click="ResetButton_Click"
                        Style="{StaticResource UtilityButtonStyle}" />
                <Button Grid.Column="3"
                        Content="保存"
                        Click="SaveButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
